{
  "test": [
    { "name": "typecheck", "cmd": "npx tsc --noEmit", "required": true },
    { "name": "lint",      "cmd": "npm run lint",     "required": true },
    { "name": "test",      "cmd": "node --test .rd/features/*/tests/*.test.*", "required": true },
    { "name": "build",     "cmd": "npm run build",    "required": false }
  ],

  "_note": "按你的项目改。required=false 的项失败只警告不阻塞。顺序即执行顺序，越便宜的放越前面，早失败早退出。test 门用不带引号的 glob 指向 .rd/features/*/tests/：AC 测试由审查层写在 .rd/features/{slug}/tests/，不在项目树里；glob 不引号，bash 自行展开、cmd 不展开所以 node 收到字面 glob 自己展开——两种 shell 都成立，还避开嵌套引号。⚠ 语法检查不再由本文件管（kind:\"syntax\" 已移除）—— 语法门下沉到 Builder 完成门（node --check / tsc --noEmit，每 task 自检）。",

  "_presets": {
    "python": [
      { "name": "typecheck", "cmd": "mypy .",            "required": true },
      { "name": "lint",      "cmd": "ruff check .",      "required": true },
      { "name": "test",      "cmd": "pytest -q .rd/features", "required": true }
    ],
    "go": [
      { "name": "vet",   "cmd": "go vet ./...",   "required": true },
      { "name": "build", "cmd": "go build ./...", "required": true },
      { "name": "test",  "cmd": "go test ./...",  "required": true }
    ],
    "rust": [
      { "name": "check", "cmd": "cargo check",              "required": true },
      { "name": "clippy","cmd": "cargo clippy -- -D warnings","required": true },
      { "name": "test",  "cmd": "cargo test",               "required": true }
    ]
  }
}
